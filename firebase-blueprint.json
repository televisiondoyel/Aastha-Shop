{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and delivery details",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "area": { "type": "string" },
        "note": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Product": {
      "title": "Store Product",
      "description": "Product items managed by admin and displayed in store catalog",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "old": { "type": "number" },
        "discount": { "type": "number" },
        "deal": { "type": "boolean" },
        "image": { "type": "string" },
        "color": { "type": "string" },
        "kind": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "price", "category"]
    },
    "StoreSetting": {
      "title": "Store & Design Settings",
      "description": "Branding, hero banner, promo banners, countdown timer, and store preferences",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "freeDelivery": { "type": "number" },
        "dealEnd": { "type": "string" },
        "logo": { "type": "string" },
        "favicon": { "type": "string" },
        "hero": { "type": "string" },
        "promo1": { "type": "string" },
        "promo2": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "Order": {
      "title": "Customer Order",
      "description": "Order records placed by customers and managed by store administrator",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "area": { "type": "string" },
        "note": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "date": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "phone", "address", "total", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Private user profiles accessible only by the owner"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Store products catalog maintained in Firestore"
    },
    "/settings/{settingId}": {
      "schema": "StoreSetting",
      "description": "Store configuration and design assets saved in Firestore"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Store orders saved and updated in Firestore"
    }
  }
}
